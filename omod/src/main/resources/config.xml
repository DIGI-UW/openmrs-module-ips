<?xml version="1.0" encoding="UTF-8"?>

<module configVersion="1.2">

	<!-- Base Module Properties -->
	<id>${project.parent.artifactId}</id>
	<name>${project.parent.name}</name>
	<version>${project.parent.version}</version>
	<package>org.openmrs.module.ips</package>
	<author>DIGI</author>
	<description>
		${project.parent.description}
	</description>

	<activator>org.openmrs.module.ips.InternationalPatientSummaryActivator</activator>

	<require_version>2.0.5</require_version>

	<aware_of_modules>
		<aware_of_module>org.openmrs.module.legacyui</aware_of_module>
	</aware_of_modules>

	<!-- Base URL of the SHR IPS mediator; /Patient/isanteplus/<id> is appended at fetch time. -->
	<globalProperty>
		<property>ips.url</property>
		<defaultValue>https://openhimcore.sedishtest.live/SHR/ips</defaultValue>
		<description>Base URL of the SHR IPS mediator that returns the consolidated IPS bundle.</description>
	</globalProperty>

	<!-- Complex concept the fetched IPS bundle is stored against (must be datatype Complex). -->
	<globalProperty>
		<property>ips.concept</property>
		<defaultValue></defaultValue>
		<description>UUID of the complex concept used to store the fetched IPS bundle.</description>
	</globalProperty>

	<globalProperty>
		<property>ips.identifierType</property>
		<defaultValue>iSantePlus ID</defaultValue>
		<description>Name or UUID of the patient identifier type whose value is sent to the mediator.</description>
	</globalProperty>

	<globalProperty>
		<property>ips.username</property>
		<defaultValue></defaultValue>
		<description>Basic-auth username for the OpenHIM channel (blank = no auth header).</description>
	</globalProperty>

	<globalProperty>
		<property>ips.password</property>
		<defaultValue></defaultValue>
		<description>Basic-auth password for the OpenHIM channel (blank = no auth header).</description>
	</globalProperty>

	<!-- Internationalization -->
	<messages>
		<lang>en</lang>
		<file>messages.properties</file>
	</messages>
	<messages>
		<lang>fr</lang>
		<file>messages_fr.properties</file>
	</messages>
	<messages>
		<lang>es</lang>
		<file>messages_es.properties</file>
	</messages>

</module>
